# Copy to .env and fill in values.
# All of these can also be set inline in configs/user.yaml using ${VAR_NAME} syntax.

# LanguageTool Premium
LANGUAGETOOL_USERNAME=your_email@example.com
LANGUAGETOOL_API_KEY=your_key_here

# OpenAI
OPENAI_API_KEY=your_key_here

# Google AI Studio (Gemini)
GEMINI_API_KEY=your_key_here

# Mistral AI
MISTRAL_API_KEY=your_key_here

# Grok / xAI (optional — adds a second red team pass when present)
GROK_API_KEY=your_key_here

# WordPress credentials
WP_USER=your_wp_username
WP_APPLICATION_PASSWORD=your_app_password_here

# Optional: Perplexity and Claude
PERPLEXITY_API_KEY=your_key_here
CLAUDE_API_KEY=your_key_here

# Optional: API keys for citation source adapters
FRED_API_KEY=your_fred_api_key
CENSUS_API_KEY=your_census_api_key
